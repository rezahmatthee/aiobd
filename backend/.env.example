# ── Server ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/aiobd

# ── JWT (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_ACCESS_SECRET=CHANGE_ME_TO_A_64_BYTE_RANDOM_HEX_STRING
JWT_REFRESH_SECRET=CHANGE_ME_TO_A_DIFFERENT_64_BYTE_RANDOM_HEX_STRING

# ── Field-level encryption ────────────────────────────────────────────────────
# Must be at least 32 characters
ENCRYPTION_SECRET=CHANGE_ME_TO_A_32_CHAR_MIN_RANDOM_SECRET
# Salt used in PBKDF2 key derivation (can be a fixed random string per environment)
ENCRYPTION_SALT=aiobd-salt-change-me-per-environment

# ── HMAC signing ──────────────────────────────────────────────────────────────
HMAC_SECRET=CHANGE_ME_TO_A_64_BYTE_RANDOM_HEX_STRING

# ── Redis (for rate limiting / session storage) ───────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── OBD Adapter ───────────────────────────────────────────────────────────────
OBD_ADAPTER_PORT=/dev/ttyUSB0
